---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="PT DPSA Group Captivates Visitors at JIFFINA 2026 | Dharma Putra Sejahtera Abadi"
>
  <Navbar isSolid={true} />

  <main class="pt-32 pb-24 min-h-[calc(100vh-80px)] bg-[#fdfdfd]">
    <div class="max-w-6xl mx-auto px-6 mb-12">
      <!-- Breadcrumb -->
      <a
        href="/articles"
        class="inline-flex items-center gap-2 text-accent-orange hover:gap-4 transition-all font-bold tracking-widest text-[0.65rem] uppercase group mb-10"
      >
        <span
          class="material-icons-outlined text-sm group-hover:-translate-x-1 transition-transform"
          >arrow_back</span
        >
        <span>Back to Articles</span>
      </a>

      <!-- Header Section -->
      <header class="mb-14 text-center max-w-4xl mx-auto">
        <div
          class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-accent-orange/10 text-accent-orange text-[0.65rem] font-bold tracking-[0.2em] uppercase mb-6"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-accent-orange animate-pulse"
          ></span>
          Event Highlights
        </div>
        <h1
          class="font-display text-4xl md:text-6xl font-extrabold text-secondary mb-6 italic leading-tight tracking-tight"
        >
          PT DPSA Group Captivates Visitors at JIFFINA 2026
        </h1>
        <p
          class="text-xl md:text-2xl text-slate-500 font-light italic max-w-2xl mx-auto"
        >
          A Fusion of Teak Elegance and Modern Manufacturing Technology
        </p>
      </header>

      <!-- Hero Image -->
      <div
        class="relative w-full mb-20 rounded-[2rem] overflow-hidden shadow-2xl shadow-secondary/10 group"
      >
        <div
          class="absolute inset-0 bg-secondary/5 mix-blend-multiply transition-opacity group-hover:opacity-0 duration-700 z-10"
        >
        </div>
        <img
          src="/images/article/6j.png"
          alt="JIFFINA 2026 Success"
          class="w-full object-cover max-h-[75vh] group-hover:scale-105 transition-transform duration-1000 ease-out"
        />
        <!-- Optional overlay gradient for cinematic feel -->
        <div
          class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/20 to-transparent z-10"
        >
        </div>
      </div>

      <!-- Content Container -->
      <article class="max-w-4xl mx-auto">
        <!-- Lead Paragraph -->
        <p class="text-slate-700 leading-loose mb-16 text-xl font-light">
          <span
            class="float-left text-7xl font-display font-bold text-accent-orange leading-none mr-4 mt-2"
            >Y</span
          >
          <strong>ogyakarta, March 2026</strong> &ndash; PT DPSA Group has triumphantly
          concluded its participation in the esteemed Jogja International Furniture
          & Craft Fair Indonesia (JIFFINA) 2026. Hosted at the Jogja Expo Center (JEC)
          from March 7th to 10th, the event provided a paramount strategic platform
          to affirm our leadership and showcase our prominence within the global furniture
          industry.
        </p>

        <!-- Section 1 -->
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24 relative"
        >
          <div class="relative z-10">
            <h2
              class="font-display text-3xl font-bold text-secondary mb-6 leading-tight"
            >
              Highlighting the Strength and Aesthetics of Indonesian Timber
            </h2>
            <div class="w-12 h-1 bg-accent-orange mb-8 rounded-full"></div>
            <p class="text-slate-600 leading-relaxed mb-6 text-lg font-light">
              Occupying a premier space in Hall B, Booth 12-A, PT DPSA Group
              unveiled an enthralling exhibition concept centered around our
              flagship loose furniture collection. The curation eloquently
              demonstrated a sophisticated marriage between the enduring quality
              of premium teak wood and the refined comfort of contemporary
              upholstery.
            </p>
            <div
              class="p-6 bg-zinc-50 border-l-4 border-accent-orange rounded-r-xl shadow-sm"
            >
              <p class="text-secondary font-medium leading-relaxed italic">
                "Our primary directive was to project the inherent beauty,
                distinct character, and structural integrity of authentic
                Indonesian timber onto the global stage. These are not merely
                durable products; they are meticulous, artisanal masterpieces
                crafted for discerning buyers seeking uncompromised premium
                quality."
              </p>
            </div>
          </div>
          <div class="w-full relative">
            <div
              class="absolute inset-0 bg-accent-orange/5 rounded-[2rem] transform translate-x-4 translate-y-4 -z-10"
            >
            </div>
            <img
              src="/images/article/7j.png"
              alt="Exclusive Collection"
              class="w-full h-auto object-cover rounded-[2rem] shadow-xl border border-white"
            />
          </div>
        </div>

        <!-- Section 2 -->
        <div
          class="mb-24 bg-white p-10 md:p-14 rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-zinc-100"
        >
          <div class="text-center mb-10 max-w-2xl mx-auto">
            <h2 class="font-display text-3xl font-bold text-secondary mb-4">
              Comprehensive Machinery for Large-Scale Projects
            </h2>
            <p class="text-slate-500 font-light text-lg">
              Beyond showcasing aesthetic excellence, JIFFINA 2026 served as a
              pivotal moment for PT DPSA Group to reaffirm our rigorous
              manufacturing capabilities.
            </p>
          </div>

          <p
            class="text-slate-600 leading-relaxed mb-8 text-lg font-light text-center max-w-3xl mx-auto"
          >
            We proudly introduced our state-of-the-art production facilities,
            which are now powered by a comprehensive suite of cutting-edge
            machinery. This strategic investment in technology empowers PT DPSA
            Group to:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
            <div
              class="bg-zinc-50 p-6 rounded-2xl border border-zinc-100/50 hover:shadow-md transition-shadow group"
            >
              <div
                class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-accent-orange shadow-sm mb-4 group-hover:scale-110 transition-transform"
              >
                <span class="material-icons-outlined"
                  >precision_manufacturing</span
                >
              </div>
              <h3 class="font-bold text-secondary mb-2">
                High-Level Precision
              </h3>
              <p class="text-sm font-light text-slate-500">
                Execute large-scale furniture projects with absolute accuracy
                and meticulous detail.
              </p>
            </div>
            <div
              class="bg-zinc-50 p-6 rounded-2xl border border-zinc-100/50 hover:shadow-md transition-shadow group"
            >
              <div
                class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-accent-orange shadow-sm mb-4 group-hover:scale-110 transition-transform"
              >
                <span class="material-icons-outlined">verified</span>
              </div>
              <h3 class="font-bold text-secondary mb-2">
                International Standards
              </h3>
              <p class="text-sm font-light text-slate-500">
                Maintain unrelenting, world-class quality checks across every
                single product fabricated.
              </p>
            </div>
            <div
              class="bg-zinc-50 p-6 rounded-2xl border border-zinc-100/50 hover:shadow-md transition-shadow group"
            >
              <div
                class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-accent-orange shadow-sm mb-4 group-hover:scale-110 transition-transform"
              >
                <span class="material-icons-outlined">local_shipping</span>
              </div>
              <h3 class="font-bold text-secondary mb-2">
                Competitive Delivery
              </h3>
              <p class="text-sm font-light text-slate-500">
                Meet and exceed rigorous delivery deadlines to fully satisfy our
                expansive global clientele.
              </p>
            </div>
          </div>

          <p class="text-slate-600 leading-relaxed text-center font-medium">
            With our extensive industry experience, we stand ready as the
            trusted partner for architects, property developers, and hospitality
            business owners requiring integrated furniture solutions.
          </p>
        </div>

        <!-- Section 3 -->
        <div class="mb-16">
          <header class="mb-12 text-center">
            <h2 class="font-display text-3xl font-bold text-secondary mb-4">
              High Enthusiasm from Local and Foreign Visitors
            </h2>
            <p
              class="text-slate-600 leading-relaxed text-lg font-light max-w-3xl mx-auto"
            >
              Throughout the four-day exhibition, the PT DPSA Group booth
              received an incredibly positive reception. This fervent enthusiasm
              was evident in the high volume of visitors&mdash;encompassing both
              local guests and international buyers&mdash;who arrived to witness
              our product detailing firsthand and foster potential strategic
              collaborations.
            </p>
          </header>

          <!-- Grid of 4 Images -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
            <div
              class="overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-shadow border border-zinc-100/50"
            >
              <img
                src="/images/article/1j.png"
                alt="Visitor Engagement 1"
                class="w-full h-auto hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div
              class="overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-shadow border border-zinc-100/50"
            >
              <img
                src="/images/article/2j.png"
                alt="Visitor Engagement 2"
                class="w-full h-auto hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div
              class="overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-shadow border border-zinc-100/50"
            >
              <img
                src="/images/article/3j.png"
                alt="Visitor Engagement 3"
                class="w-full h-auto hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div
              class="overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-shadow border border-zinc-100/50"
            >
              <img
                src="/images/article/4j.png"
                alt="Visitor Engagement 4"
                class="w-full h-auto hover:scale-105 transition-transform duration-500"
              />
            </div>
          </div>

          <!-- Call to Action -->
          <div
            class="bg-secondary text-white rounded-[2rem] p-10 text-center relative overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-[url('/images/pattern.svg')] opacity-5"
            >
            </div>
            <div class="relative z-10 max-w-2xl mx-auto">
              <span
                class="material-icons-outlined text-4xl text-accent-orange mb-4 opacity-80"
                >explore</span
              >
              <h3 class="font-display text-2xl font-bold mb-4 italic">
                Discover Our Latest Collections
              </h3>
              <p class="text-zinc-300 font-light mb-8 leading-relaxed">
                Want to learn more about our premium products and services?
                Connect with our dedicated team or explore our exclusive product
                catalog online.
              </p>
              <a
                href="https://wa.me/6281128507788"
                target="_blank"
                class="inline-flex items-center gap-3 bg-accent-orange hover:bg-white hover:text-accent-orange text-white px-8 py-4 rounded-full font-bold text-xs uppercase tracking-[0.15em] transition-all duration-300 shadow-lg shadow-accent-orange/20"
              >
                <span class="material-icons-outlined text-sm">chat</span>
                Contact Our Team
              </a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </main>

  <Footer />
</Layout>
