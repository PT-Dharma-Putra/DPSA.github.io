---
const articles = [
  {
    title: "PT DPSA Group Captivates Visitors at JIFFINA 2026",
    date: "March 2026",
    excerpt:
      "PT DPSA Group has successfully participated in the prestigious international furniture exhibition, Jogja International Furniture & Craft Fair Indonesia (JIFFINA) 2026.",
    image: "/images/article/6j.png",
    slug: "jiffina-2026-success",
    category: "Article",
  },
  {
    title: "The Success of PT DPSA Group at IFEX 2026",
    date: "March 2026",
    excerpt:
      "PT DPSA Group has successfully concluded its participation in the prestigious international furniture exhibition, the Indonesia International Furniture Expo (IFEX) 2026.",
    image: "/images/article/revisi 1.png",
    slug: "ifex-2026-success",
    category: "Article",
  },
  {
    title: "We Are Present at JIFFINA 2026",
    date: "March 07 - 10, 2026",
    excerpt:
      "Sorajati is proud to participate in the Jogja International Furniture & Craft Fair (JIFFINA) 2026. Find us at Jogja Expo Center!",
    image: "/images/PosterJIFFINA.png",
    slug: "jiffina-2026",
    category: "Event",
  },
];
---

<section id="articles" class="py-24 bg-zinc-50 relative overflow-hidden">
  <!-- Decorative Background Elements -->
  <div class="absolute top-0 left-0 w-1/3 h-1/3 bg-primary/5 rounded-full blur-[120px] -translate-y-1/2 -translate-x-1/2"></div>
  <div class="absolute bottom-0 right-0 w-1/4 h-1/4 bg-primary/5 rounded-full blur-[100px] translate-y-1/2 translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
      <div data-aos="fade-right">
        <span class="text-accent-orange font-bold tracking-[0.3em] uppercase text-xs mb-3 block">
          Latest Updates
        </span>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-secondary italic uppercase tracking-tight">
          Articles & Events
        </h2>
      </div>
      <div class="mt-6 md:mt-0" data-aos="fade-left">
        <a
          href="/articles"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-secondary text-white font-bold text-xs uppercase tracking-wider hover:bg-accent-orange transition-all duration-300 shadow-lg shadow-secondary/10 hover:shadow-accent-orange/20"
        >
          View All Articles
          <span class="material-icons-outlined text-sm">arrow_forward</span>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {
        articles.map((article, index) => (
          <div 
            class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 border border-zinc-100 flex flex-col h-full transform hover:-translate-y-2 w-full"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="relative aspect-[4/5] overflow-hidden">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <div
                class={`absolute top-4 right-4 ${article.category === "Event" ? "bg-accent-orange" : "bg-secondary"} text-white text-[10px] font-bold px-3 py-1.5 rounded-full tracking-widest uppercase shadow-lg`}
              >
                {article.category}
              </div>
            </div>

            <div class="p-8 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-slate-400 text-[10px] uppercase tracking-widest font-bold mb-4">
                <span class="material-icons-outlined text-sm">
                  calendar_today
                </span>
                {article.date}
              </div>

              <h3 class="font-display text-2xl font-bold text-secondary mb-4 group-hover:text-accent-orange transition-colors duration-300">
                {article.title}
              </h3>

              <p class="text-slate-500 text-sm leading-relaxed mb-8 line-clamp-3">
                {article.excerpt}
              </p>

              <div class="mt-auto">
                <a
                  href={`/articles/${article.slug}`}
                  class="inline-flex items-center gap-2 font-bold text-xs uppercase tracking-wider text-secondary group-hover:text-accent-orange transition-colors"
                >
                  Read More
                  <span class="material-icons-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
